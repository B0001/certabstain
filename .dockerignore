# Keep the build context small. `COPY . /app/certabstain/` is deliberately
# broad (the repo is the package), so this file is what keeps .git, the host
# .venv, and prior sweep output out of the image.

.git
.gitignore
.venv
__pycache__
**/__pycache__
*.pyc
*.egg-info
**/*.egg-info

# Prior sweep output -- regenerated by the Job, never an input to it. Baking a
# stale artifacts/ in would also shadow the PVC mount point's ownership.
artifacts

# Test/lint caches
.pytest_cache
.ruff_cache

# Tests need the dev group (pytest, scipy, onnx, mpmath) that the runtime image
# deliberately omits, so they would not be runnable in here anyway.
test_*.py

# Docs and notes: not runtime inputs. README.md is kept because pyproject
# declares `readme = "README.md"`.
SPEC.md
TECHNICAL_NOTE.md
PROVISIONAL_OUTLINE.md
invention_idea.md
compass_artifact_*.md
.claude

# Editor/OS noise
.DS_Store
.idea
.vscode
